<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./components/header.ejs') %>

    <link rel="stylesheet" href="../stylesheets/forgot.style.css" />

    <script>
      window.FRONTEND_URL = "<%= FRONTEND_URL %>";
    </script>

    <title>Forgot Password</title>
  </head>

  <body style="margin: 0; padding: 0">
    <div class="forgot-page">
      <div class="forgot-card">
        <!-- Header -->
        <div class="forgot-card-header">
          <div class="logo-wrapper">
            <img src="../assets/logo.svg" alt="Zenmonk logo" class="logo" />
          </div>

          <h1 class="forgot-title">Forgot Password?</h1>

          <p class="forgot-description">
            Don't worry, it happens. Please enter the email address associated
            with your account.
          </p>
        </div>

        <!-- Content -->
        <div class="forgot-card-content">
          <form
            id="form"
            action="/password/forgot"
            method="POST"
            class="forgot-form"
          >
            <!-- Email -->
            <div class="form-field">
              <label for="email" class="form-label"> Email </label>

              <div class="input-group">
                <input
                  id="email"
                  name="email"
                  type="email"
                  class="form-input"
                  placeholder="name@company.com"
                  autocomplete="email"
                  required
                />

                <span class="input-icon">
                  <span class="material-icons-outlined"> mail </span>
                </span>
              </div>

              <span id="error-message" class="error-message">
                <span id="error"></span>
              </span>
            </div>

            <!-- Submit -->
            <button type="submit" class="submit-button" id="submitButton">
              <span class="button-content">
                <span>Submit</span>

                <span class="material-symbols-outlined"> arrow_forward </span>
              </span>
            </button>

            <!-- Back -->
            <button type="button" class="back-button" onclick="history.back()">
              <span class="material-symbols-outlined"> arrow_back </span>

              <span> Go back </span>
            </button>
          </form>
        </div>
      </div>
    </div>

    <%- include('./components/snackbar.ejs') %>

    <script src="/scripts/forgot.js"></script>
  </body>
</html>
