FROM node:20.13.1-alpine3.20

WORKDIR /app

COPY package*.json ./
COPY apps/lms-frontend/package*.json ./apps/lms-frontend/
COPY packages ./packages

RUN npm install

RUN npm run build --workspace=@repo/common

COPY apps/lms-frontend ./apps/lms-frontend

WORKDIR /app/apps/lms-frontend

COPY apps/lms-frontend/.env.example ./.env

EXPOSE 3000

RUN npm run build

RUN cp -r public .next/standalone/apps/lms-frontend/public && \
    cp -r .next/static .next/standalone/apps/lms-frontend/.next/static

CMD ["node", ".next/standalone/apps/lms-frontend/server.js"]