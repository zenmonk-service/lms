FROM node:20.13.1-alpine3.20

WORKDIR /app

COPY package*.json ./
COPY apps/lms-frontend/package*.json ./apps/lms-frontend/
COPY packages ./packages

RUN npm install

RUN npm run build --workspace=@repo/common

COPY apps/lms-frontend ./apps/lms-frontend

WORKDIR /app/apps/lms-frontend

COPY apps/lms-frontend/.env.example ./.env

EXPOSE 3000

CMD ["sh", "-c", "npm run dev --workspace=lms-frontend -- --hostname 0.0.0.0"]